# Stop searching for other .editorconfig files in parent folders
root = true

# Default for every file
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: two trailing spaces = line break, keep them
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[{Makefile,*.mk}]
indent_style = tab

# Windows scripts need CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf
