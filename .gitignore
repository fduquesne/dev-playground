# =============================================================
#  dev-playground — global .gitignore
#  Patterns without a leading "/" apply at every depth,
#  so they cover every module (nextjs/00-xxx, deno/01-xxx…).
# =============================================================


# -------------------------------------------------------------
#  Module templates (boilerplates, kept local only)
# -------------------------------------------------------------
/*/_template/


# -------------------------------------------------------------
#  Node.js / package managers (Next.js, and Deno in npm mode)
# -------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
bun-debug.log*


# -------------------------------------------------------------
#  Next.js
# -------------------------------------------------------------
.next/
out/
build/
next-env.d.ts
.vercel/
.turbo/
*.tsbuildinfo


# -------------------------------------------------------------
#  Generic build / cache outputs
# -------------------------------------------------------------
dist/
.cache/
.parcel-cache/
.vite/
.eslintcache
.stylelintcache
.swc/
*.tmp
*.temp
tmp/
temp/


# -------------------------------------------------------------
#  Tests & coverage
# -------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
junit.xml


# -------------------------------------------------------------
#  Logs
# -------------------------------------------------------------
logs/
*.log


# -------------------------------------------------------------
#  Local databases (exercise data)
# -------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal


# -------------------------------------------------------------
#  Editors & IDEs
# -------------------------------------------------------------
# VS Code: share settings/extensions recommendations, ignore the rest
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
.history/


# -------------------------------------------------------------
#  Operating systems
# -------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*


# -------------------------------------------------------------
#  Misc
# -------------------------------------------------------------
*.bak
*.orig
*.rej
.scratch/
